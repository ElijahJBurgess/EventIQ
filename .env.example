# ─────────────────────────────────────────────────────────────────────────────
# Client env — copy this file to `.env` and fill in real values.
# `.env` is gitignored. Everything prefixed VITE_ is inlined into the browser
# bundle by Vite, so it must be PUBLIC-SAFE (the Supabase anon/publishable key
# is designed to be public; RLS is what protects the data).
# ─────────────────────────────────────────────────────────────────────────────

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────────────────────
# Server-side only — NEVER prefix with VITE_ (that would leak it to the browser).
# Only used by local tooling that runs outside the Vite build (migration
# scripts, `supabase` CLI, CI). Not needed just to run `npm run dev`.
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_SECRET_KEY="sb_secret_xxxxxxxxxxxxxxxxxxxxxx"

# ─────────────────────────────────────────────────────────────────────────────
# Edge Function secrets — these do NOT live in this file. They are set on the
# Supabase project (Dashboard → Project Settings → Edge Functions → Secrets, or
# `supabase secrets set`). Listed here so you know what the functions expect.
#
#   SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#       auto-injected by Supabase into every function — do not set manually.
#   OOO_ADMIN_PASSWORD
#       plaintext organizer password for the /v2/admin dashboard (admin-auth
#       compares SHA-256(this) to the hash the client sends).
#   OOO_Intellegence_Open_API_Key
#       OpenAI API key used by `concierge` and `admin-auth` (insights/copilot).
#   CONCIERGE_ALLOWED_ORIGINS, MATCH_ENGINE_ALLOWED_ORIGINS,
#   DELETE_ACCOUNT_ALLOWED_ORIGINS, ADMIN_AUTH_ALLOWED_ORIGINS
#       optional comma-separated extra CORS origins. localhost:8080 and the
#       prod URL are already defaulted in code; only set this for a new domain
#       or Vercel preview URLs.
#   CONCIERGE_OPENAI_MODEL, INSIGHTS_OPENAI_MODEL
#       optional model-id overrides (default: gpt-5.4-mini).
# ─────────────────────────────────────────────────────────────────────────────
